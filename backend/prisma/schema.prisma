datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum TokenType {
  OTP
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AuditAction {
  PROJECT_CREATE
  PROJECT_UPDATE
  API_KEY_CREATED
  API_KEY_REVOKED
  OTP_GENERATE
  OTP_VERIFY
  EMAIL_SENT
  AUTH_FAILED
  RATE_LIMITED
}

// ------------------------------------------------------
// PROJECTS & API KEYS SYSTEM (SERVER-TO-SERVER)
// ------------------------------------------------------

model Project {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  apiKeys   ApiKey[]
  otpTokens OtpToken[]
  auditLogs AuditLog[]

  @@map("projects")
}

model ApiKey {
  id         String    @id @default(uuid())
  projectId  String    @map("project_id")
  name       String    @db.VarChar(100)
  prefix     String    @db.VarChar(20)
  keyHash    String    @unique @map("key_hash") @db.VarChar(255)
  isActive   Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([keyHash, isActive])
  @@index([projectId])
  @@map("api_keys")
}

// ------------------------------------------------------
// OTP & TOKENS MANAGEMENT
// ------------------------------------------------------

model OtpToken {
  id             String    @id @default(uuid())
  projectId      String    @map("project_id")
  recipientEmail String    @map("recipient_email") @db.VarChar(255)
  codeHash       String    @map("code_hash") @db.VarChar(255)
  type           TokenType @default(OTP)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3) @map("max_attempts")
  isUsed         Boolean   @default(false) @map("is_used")
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, recipientEmail, type, isUsed, createdAt])
  @@index([projectId, recipientEmail, createdAt])
  @@index([projectId])
  @@index([expiresAt])
  @@map("otp_tokens")
}

// ------------------------------------------------------
// AUDIT LOGS SYSTEM
// ------------------------------------------------------

model AuditLog {
  id        String      @id @default(uuid())
  projectId String?     @map("project_id")
  action    AuditAction
  resource  String      @db.VarChar(100)
  details   Json?
  createdAt DateTime    @default(now()) @map("created_at")

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
