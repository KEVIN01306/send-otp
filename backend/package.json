{
  "name": "auth-notifier-service",
  "version": "1.0.0",
  "description": "backend for auth-notifier-service",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "cross-env NODE_ENV=development nodemon --exec node --import tsx src/server.ts",
    "db:migrate": "npx prisma migrate dev",
    "db:studio": "npx prisma studio",
    "start": "node --import tsx src/server.ts",
    "build": "tsc && tsc-alias"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "author": "kevin-sanchez",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@prisma/client": "^6.19.2",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "jose": "^6.1.3",
    "resend": "^6.32.0",
    "tsc-alias": "^1.9.2",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.11",
    "prisma": "^6.19.2",
    "supertest": "^7.3.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}