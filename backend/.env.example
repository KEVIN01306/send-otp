# Database configuration
DATABASE_URL="mysql://root:password@localhost:3306/otp_microservice_db"

# Server configuration
PORT=3000
NODE_ENV=development

# Resend Email Configuration
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Auth Service <onboarding@resend.dev>"

# Admin Master Key (for administrative endpoints)
ADMIN_MASTER_KEY="super_secret_admin_master_key_123456"

# OTP & Token Configuration
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=60
