# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

PORT        =8000

DATABASE_URL="mysql://root:admin123@localhost:3306/otp_microservice_db"


# --- Configuración de JWT (jose) ---
# Un secreto largo y aleatorio (puedes generarlo con 'openssl rand -base64 32')
JWT_SECRET="3+(n88v4O`V%vhFEw31j8M9{~uQbK4;("

# Identificador de quién emite el token (usualmente tu dominio o nombre de app)
JWT_ISS="https://otp.send.com"

# Audiencia a la que va dirigido (quién debería consumir este token)
JWT_AUD="https://otp.send.com"

# Tiempos de vida (TTL)
# El Access Token debe ser corto (15 min) para mitigar robos
JWT_ACCESS_TTL="15m"

# El Refresh Token debe ser largo (7 días) para no cerrar sesión al usuario seguido
JWT_REFRESH_TTL="7d"

# Resend
RESEND_API_KEY=
EMAIL_FROM="Auth OTP Service <noreply@resend.com>"

# Admin Master Key
ADMIN_MASTER_KEY="7£bg0J\VI@X7EPu"E?jHOjt£0e9-5Y/QIxi_e'c|tbrD'Dlv9'"

# OTP Configuration
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=60